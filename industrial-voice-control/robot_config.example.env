# Copy this file to robot_config.local.env before entering a private test environment.
# The loader accepts only the six settings listed below; unknown lines are ignored.
# Never commit robot_config.local.env, production addresses, registers, or motion values.
# Keep real action maps in a restricted private deployment branch or controller project.

# Keep false until the complete private safety review is finished.
ROBOT_CONTROL_ENABLED=false

# Safe public defaults. Replace only in your private local file.
ROBOT_MODBUS_HOST=127.0.0.1
ROBOT_MODBUS_PORT=502
ROBOT_COMMAND_REGISTER=40001

# Local reference service uses a non-privileged loopback port by default.
LOCAL_MODBUS_HOST=127.0.0.1
LOCAL_MODBUS_PORT=1502
